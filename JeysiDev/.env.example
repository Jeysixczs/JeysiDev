# Copy to .env.local (local) and add the same vars in Vercel > Project > Settings > Environment Variables.
# Never prefix these with VITE_ (that would expose them in the browser).
GEMINI_API_KEY=your_key_here
# Models are tried in order; if one is out of quota the next is used.
# Biggest free daily quota first, tiny-quota models last.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it,gemini-3.8-flash,gemini-3.6-flash
