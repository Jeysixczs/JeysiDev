PORT=5000

# Origin allowed to call this API (your frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Where contact form messages should be delivered
CONTACT_TO_EMAIL=hello@jeysidev.com

# SMTP credentials for sending contact form emails.
# If left blank, submissions are just logged to the server console
# (useful for local development without a real mail provider).
# Example values for Gmail SMTP with an App Password, or use
# a transactional provider like SendGrid / Mailgun / Postmark.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
